# 이 파일을 .env로 복사하고 값을 입력한 다음 아래 명령으로 불러오세요.
# set -a; source .env; set +a
# ChatGPT의 노션 연결과 별개로, Python 실행용 Notion 내부 통합 토큰이 필요합니다.
NOTION_TOKEN=
# 사용할 표의 데이터 소스 ID를 입력하세요.
NOTION_DATA_SOURCE_ID=

# 이메일은 선택 사항입니다. 모두 비워 두면 발송하지 않습니다.
EMAIL_SENDER=
EMAIL_RECEIVER=
EMAIL_APP_PASSWORD=

# 노션 등록은 기본으로 끕니다. 다시 사용하려면 1로 변경하세요.
ENABLE_NOTION_SYNC=0
